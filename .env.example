# Agent configuration (spec §10, D-039). Copy to .env (git-ignored) and fill in.
# Any OpenAI-compatible chat-completions endpoint with tool calling works.
# Leave LLM_BASE_URL or LLM_API_KEY empty to run the agent in offline mode (no network).
# Never commit a real key: .env is git-ignored, this file holds placeholders only.

# --- Preset: Google Gemini (free tier) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your-gemini-api-key-here

# --- Preset: Groq ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your-groq-api-key-here

# --- Preset: local Ollama (no key needed; any non-empty placeholder) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# --- claude.ai/code cloud session ---
# The real key is a network secret that the session proxy attaches to requests to the
# provider's host; the code never sees it. Set the placeholder:
# LLM_API_KEY=proxy-injected
