# Agent settings for LOCAL use (spec §10, D-039, D-045). scripts/setup_local.* copies this file
# to .env (git-ignored) if .env does not exist; put your own key in LLM_API_KEY there.
# Leave LLM_API_KEY empty to run offline (no network). Placeholders only: never commit a key.
# The public demo (PUBLIC_DEMO=1) ignores this file; visitors enter their own key in the app.

# --- Default preset: Google Gemini (OpenAI-compatible endpoint) ---
# Gemini keys must be AI Studio auth keys (https://aistudio.google.com/apikey). A Google Cloud
# key restricted to other APIs is refused with 403 API_KEY_SERVICE_BLOCKED.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=

# --- Preset: Groq ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# --- Preset: local Ollama (no key needed; any non-empty placeholder such as "ollama") ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=
